[Unit]
Description=PrimerForge (primer design, BLAST/BLAT and transcript views)
Documentation=file://@APP_DIR@/app/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
EnvironmentFile=@CONF_DIR@/primerforge.env
WorkingDirectory=@APP_DIR@/app
ExecStart=@APP_DIR@/venv/bin/python @APP_DIR@/app/serve.py
Restart=on-failure
RestartSec=5
# BLAT gfServers are child processes; give them time to stop cleanly.
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target
