[Unit]
Description=PrimerForge HTTPS proxy (Caddy)
Documentation=https://caddyserver.com/docs/
Wants=network-online.target
After=network-online.target primerforge.service

[Service]
Type=notify
User=primerforge-caddy
Group=primerforge-caddy
# Certificates and keys live here.
Environment=XDG_DATA_HOME=/var/lib/primerforge-caddy XDG_CONFIG_HOME=/var/lib/primerforge-caddy HOME=/var/lib/primerforge-caddy
ExecStart=@APP_DIR@/caddy/caddy run --config @CONF_DIR@/Caddyfile --adapter caddyfile
ExecReload=@APP_DIR@/caddy/caddy reload --config @CONF_DIR@/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/primerforge-caddy

[Install]
WantedBy=multi-user.target
